@page "/ticket"
@model TicketModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <title>Justificante de reserva</title>
    <link rel="stylesheet" href="/css/sites.css">
</head>

<body>
    <h1>Justificante de reserva</h1>
    <p>Producto: @Model.Ticket.Product</p>
    <p>Kilos: @Model.Ticket.Kg</p>
    <p>Recogida: @Model.Ticket.PickupLocation</p>
    <p>Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
</body>

</html>
