@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"] - NovaHarvest</title>
    <link rel="stylesheet" href="/css/sites.css">
</head>
<body>
    <header>
        <img src="/img/logo.png" alt="Logotipo de NovaHarvest">
        <h2>NovaHarvest</h2>
        <nav>
            <a href="/">Inicio</a>
            <a href="/about">Acerca de</a>
            <a href="/status">Estado</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>NovaHarvest · IES Valle del Jerte · 2026 · Entorno: @Env.EnvironmentName</footer>
</body>
</html>